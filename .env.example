# ==========================================
# NapCat / OneBot11 通信配置
# ==========================================
NAPCAT_HTTP_URL=http://127.0.0.1:3002
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=your_napcat_token_here

# ==========================================
# QQ 官方机器人 (QQ 开放平台) 配置
# ==========================================
QQ_BOT_APP_ID=your_qq_bot_appid_here
QQ_BOT_APP_SECRET=your_qq_bot_secret_here
QQ_BOT_SANDBOX=false

# ==========================================
# LLM / AI 对话服务配置 (DeepSeek / Anthropic 协议)
# ==========================================
ANTHROPIC_AUTH_TOKEN=your_ai_api_key_here
AI_BASE_URL=https://api.deepseek.com/anthropic
AI_MODEL=deepseek-v4-flash

# 小米 MiMo 视觉识图 API (可选)
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key_here

# ==========================================
# 语音合成 (TTS) 服务配置
# ==========================================
VOCU_TTS_API_KEY=your_vocu_api_key_here
VOCU_DEFAULT_VOICE_ID=your_voice_uuid_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ==========================================
# AstrBot 控制台连接 (用于 WebSocket 桥接)
# ==========================================
ASTRBOT_API_URL=http://127.0.0.1:6185
ASTRBOT_USERNAME=astrbot
ASTRBOT_PASSWORD=your_dashboard_password_here
